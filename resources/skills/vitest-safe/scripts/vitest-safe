#!/usr/bin/env python3
"""Run a command while holding one slot in the global Vitest queue."""

from __future__ import annotations

import fcntl
import json
import os
import shlex
import sys
import time
from pathlib import Path


POLL_SECONDS = 0.2
STATUS_SECONDS = 5.0


def usage() -> None:
    print(
        "用法: vitest-safe -- <command> [args...]\n"
        "示例: vitest-safe -- pnpm exec vitest run",
        file=sys.stderr,
    )


def default_shared_state_dir() -> Path:
    configured = os.environ.get("VITEST_SAFE_STATE_DIR")
    if configured:
        return Path(configured).expanduser()
    xdg_state = os.environ.get("XDG_STATE_HOME")
    base = Path(xdg_state).expanduser() if xdg_state else Path.home() / ".local" / "state"
    return base / "chimata-vitest-safe"


def config_path() -> Path:
    configured = os.environ.get("VITEST_SAFE_CONFIG")
    if configured:
        return Path(configured).expanduser()
    shared = default_shared_state_dir() / "config.json"
    if shared.exists():
        return shared

    host_configs = []
    if os.environ.get("CLAUDE_CODE_SESSION_ID") or os.environ.get("CLAUDECODE"):
        claude_home = Path(os.environ.get("CLAUDE_HOME", "")).expanduser() if os.environ.get("CLAUDE_HOME") else Path.home() / ".claude"
        host_configs.append(claude_home / "vitest-safe" / "config.json")
    codex_home = Path(os.environ.get("CODEX_HOME", "")).expanduser() if os.environ.get("CODEX_HOME") else Path.home() / ".codex"
    host_configs.append(codex_home / "vitest-safe" / "config.json")

    for descriptor_path in host_configs:
        if not descriptor_path.exists():
            continue
        try:
            descriptor = json.loads(descriptor_path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            return descriptor_path
        runtime_path = descriptor.get("runtime_config")
        return Path(runtime_path).expanduser() if runtime_path else descriptor_path
    return shared


def load_config() -> tuple[int, Path]:
    path = config_path()
    try:
        with path.open("r", encoding="utf-8") as handle:
            config = json.load(handle)
    except FileNotFoundError:
        config = {"max_concurrent": 2, "lock_dir": str(path.parent / "locks")}
    except (OSError, json.JSONDecodeError) as exc:
        raise RuntimeError(f"无法读取配置文件 {path}: {exc}") from exc

    try:
        max_concurrent = int(os.environ.get("VITEST_SAFE_MAX_CONCURRENT", config["max_concurrent"]))
    except (KeyError, TypeError, ValueError) as exc:
        raise RuntimeError(f"配置文件中的 max_concurrent 无效: {path}") from exc
    if max_concurrent < 1:
        raise RuntimeError("配置文件中的 max_concurrent 必须是正整数")

    raw_lock_dir = os.environ.get("VITEST_SAFE_LOCK_DIR") or config.get("lock_dir")
    if not raw_lock_dir:
        raw_lock_dir = str(path.parent / "locks")
    lock_dir = Path(str(raw_lock_dir)).expanduser()
    if not lock_dir.is_absolute():
        lock_dir = path.parent / lock_dir
    return max_concurrent, lock_dir


def acquire_slot(lock_dir: Path, max_concurrent: int) -> tuple[int, int, float]:
    lock_dir.mkdir(parents=True, exist_ok=True)
    started = time.monotonic()
    last_status = started - STATUS_SECONDS

    while True:
        for slot in range(max_concurrent):
            lock_path = lock_dir / f"slot-{slot:04d}.lock"
            fd = os.open(lock_path, os.O_RDWR | os.O_CREAT, 0o600)
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                os.close(fd)
                continue
            except BaseException:
                os.close(fd)
                raise

            # The command replaces this process. Keeping the descriptor
            # inheritable makes the kernel lock live for the actual test
            # process instead of only for a short-lived wrapper parent.
            os.set_inheritable(fd, True)
            return fd, slot, time.monotonic() - started

        now = time.monotonic()
        if now - last_status >= STATUS_SECONDS:
            print(
                f"vitest-safe: 已达到并发上限 {max_concurrent}，正在队列中等待可用 slot...",
                file=sys.stderr,
                flush=True,
            )
            last_status = now
        time.sleep(POLL_SECONDS)


def run(command: list[str]) -> int:
    max_concurrent, lock_dir = load_config()
    fd = -1
    try:
        fd, slot, waited = acquire_slot(lock_dir, max_concurrent)
        if waited >= POLL_SECONDS:
            print(
                f"vitest-safe: 已获得 slot {slot + 1}/{max_concurrent}，等待 {waited:.1f}s",
                file=sys.stderr,
                flush=True,
            )
        try:
            os.execvpe(command[0], command, os.environ.copy())
        except FileNotFoundError:
            print(f"vitest-safe: 找不到命令: {shlex.join(command)}", file=sys.stderr)
            return 127
        except OSError as exc:
            print(f"vitest-safe: 无法启动命令 {shlex.join(command)}: {exc}", file=sys.stderr)
            return 126
    except KeyboardInterrupt:
        print("vitest-safe: 已取消排队等待", file=sys.stderr)
        return 130
    except RuntimeError as exc:
        print(f"vitest-safe: {exc}", file=sys.stderr)
        return 2
    finally:
        if fd >= 0:
            os.close(fd)


def main(argv: list[str]) -> int:
    if len(argv) < 2 or argv[0] != "--":
        usage()
        return 2
    return run(argv[1:])


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
